---
layout: null
sitemap: false
permalink: /search.json
---
{
  "items": [
    {%- assign items = "" | split: "" -%}
    {%- for t in site.tutorials -%}
      {%- assign items = items | push: t -%}
    {%- endfor -%}
    {%- for p in site.posts -%}
      {%- assign items = items | push: p -%}
    {%- endfor -%}
    {%- for it in items -%}
    {
      "title": {{ it.title | jsonify }},
      "subtitle": {{ it.subtitle | default: "" | jsonify }},
      "url": {{ it.url | relative_url | jsonify }},
      "kind": {%- if it.url contains "/tutorials/" -%}"tutorial"{%- else -%}"post"{%- endif -%},
      "tags": {{ it.tags | default: empty_array | jsonify }},
      "date": {%- if it.date -%}{{ it.date | date: "%Y-%m-%d" | jsonify }}{%- else -%}""{%- endif -%},
      "body": {{ it.content | strip_html | strip_newlines | truncate: 800 | jsonify }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "suggestions": [
    "PINNs",
    "neural networks",
    "training loop",
    "scikit-learn",
    "CNN",
    "SynaCAD"
  ]
}
